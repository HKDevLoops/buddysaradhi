.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Scratch/temp files
# `scratch_*.ts` only matched files at the repo root, so everything inside the
# scratch/ DIRECTORY was committed. scratch/test-turso-web.ts shipped a live
# Turso auth token to origin/main because of this gap.
scratch/
scratch_*.ts
scratch_*.js

# Session dumps (agent transcripts pasted as context — stay on disk, never pushed)
previous_session_back.md
session-ses_ef88.md

# Full session transcripts dumped at the repo root for an agent to read.
# `big_rebase.md` was a 45 MB transcript (system prompts, tool JSON, diffs,
# and — because it embedded the transcript of a gitleaks run — copies of the
# very findings the scanner reports). It was unreferenced by any code or doc and
# was sitting UNIGNORED, one `git add -A` away from landing in history. These
# belong outside the repository entirely, not merely uncommitted.
big_rebase.md
sess_prev.md
sess_*.md
session_*.md
session-*.md
typecheck-out.txt
test-output.txt

# Agents 
./.agent/
./.agents/
./.kilo/ 
./.claude/ 
./.gemini/
./.*

.vercel
.env*
# A TEMPLATE carries no secret — it is the documented home of every key name
# the app reads. `apps/gateway/.env.example` was already tracked (force-added)
# and `apps/web/.env.example` was not, which is exactly the inconsistency that
# left `ALLOW_DEV_AUTH` documented nowhere a developer would look (audit
# AUD-008). Only the exact filename is un-ignored: `.env.local`,
# `.env.production` and every other real env file stay ignored.
!.env.example

testsprite_tests\tmp\config.json
testsprite_tests/tmp/
testsprite_tests/tmp/config.json
# Local tool caches (deno-lsp npm/registry cache under apps/gateway/.cache is
# ~1.9 GB / 113k files — untracked AND unignored it made `git add -A` a
# footgun and made scripts/principle-lints.ts run for minutes emitting
# "Filename too long" before it could reach product code).
.cache/
**/.cache/

# Agent scratch files at the repo root. Audit + review agents drop throwaway
# probes here (`.tmp-hunt*.ts`, `.tmp-negctl.ps1`, `.tmp-rig.sh`, ...). They
# are untracked AND unignored, which makes them one `git add -A` away from
# landing in history — and several of them contain live credential material
# read out of the local .env files. They belong in the OS temp directory, not
# in the repository. (2026-10-21 supply-chain audit, SC-09.)
.tmp-*
.tmp_*

# Generated CycloneDX SBOMs (CI artefacts, not source — scripts/sbom-generator.ts
# writes them; 23_Security_Harness_Plan.md §5.3).
sbom/
osv-report.json
