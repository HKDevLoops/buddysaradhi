# Local SQLite database URL (no quotes — the Prisma CLI cannot parse quoted values).
DATABASE_URL=file:./dev.db

# Port the gateway listens on.
PORT=3001

# Token required in the X-Admin-Token header for the destructive
# POST /api/v1/security/erase endpoint. The web BFF forwards this on the
# internal call; it must never be exposed to the browser.
# CHANGE THIS in every environment.
GATEWAY_ADMIN_TOKEN=change-me

# Comma-separated list of origins allowed by CORS. Requests from origins not
# listed here are rejected (no "*" fallback). Example:
# ALLOWED_ORIGINS=https://app.buddysaradhi.app,https://admin.buddysaradhi.app
ALLOWED_ORIGINS=http://localhost:3000
