# Local SQLite database URL (no quotes — the Prisma CLI cannot parse quoted values).
DATABASE_URL=file:./dev.db

# Port the gateway listens on.
PORT=3001

# Token required in the X-Admin-Token header for the destructive
# POST /api/v1/security/erase endpoint. The web BFF forwards this on the
# internal call; it must never be exposed to the browser.
# CHANGE THIS in every environment.
GATEWAY_ADMIN_TOKEN=change-me

# Comma-separated list of origins allowed by CORS. Requests from origins not
# listed here are rejected (no "*" fallback). Example:
# ALLOWED_ORIGINS=https://app.buddysaradhi.app,https://admin.buddysaradhi.app
ALLOWED_ORIGINS=http://localhost:3000

# Development authentication. OFF unless you set this to exactly "true".
#
# A `Bearer mock-token-<tenant>` request authenticates by TRUSTING the caller's
# `X-Tutor-Id` header, so it is a bypass by construction. It is therefore
# opt-IN: with this unset the gateway answers those requests 401, and the web app
# (apps/web/src/server/get-db.ts) refuses to mint one. That direction matters —
# the previous gate was "open unless the environment looked like production",
# which fails OPEN whenever DENO_ENV and DENO_DEPLOYMENT_ID are both missing,
# i.e. on exactly the self-hosted deployment nobody tested.
#
# Even with this set, a request that looks deployed is still refused, so a stray
# flag cannot open dev auth in production.
#
# apps/web must set the SAME variable for its local-dev sessionless path.
ALLOW_DEV_AUTH=false

# Data/signing key separation (Phase 3, docs/adr/0006-data-signing-key-separation.md).
#
# DATA_ENCRYPTION_KEY is the transport-encryption key. When unset the gateway
# falls back to GATEWAY_SHARED_SECRET (historical behaviour) and says so LOUDLY
# at boot (crypto.data_key_fallback). Set it to a value DISTINCT from
# GATEWAY_SHARED_SECRET (same >= 32-char floor) to separate the two domains.
#
# STRICT_KEY_SEPARATION forbids the fallback: with this set to exactly "true"
# the gateway REFUSES TO BOOT unless DATA_ENCRYPTION_KEY is set. Default OFF —
# arming procedure: set DATA_ENCRYPTION_KEY everywhere → deploy → confirm the
# fallback warn is gone → flip this → verify → only then rotate the old secret.
# DATA_ENCRYPTION_KEY=
# STRICT_KEY_SEPARATION=false

# Trusted proxies for client-IP resolution (F-05b).
#
# The gateway CANNOT know its own deployment topology. On Cloudflare/Supabase
# Edge `cf-connecting-ip` is authoritative and `x-forwarded-for` is stripped
# unconditionally — nothing to configure. But a SELF-HOSTED gateway behind
# nginx sees only the proxy's address as its peer, and the client's address
# (if at all) inside `x-forwarded-for`: a header the client also writes.
# Trusting it blindly lets any caller rotate rate-limit identities per request
# (`X-Forwarded-For: <random>`); ignoring it always collapses every proxied
# client into one bucket. Neither default fits every deployment.
#
# Declare yours: comma-separated exact IPs and/or IPv4 CIDRs of proxies you
# operate (e.g. `TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8`). Empty (default)
# preserves exactly today's behavior. Non-empty arms strict mode: a peer that
# IS declared resolves the client from the LAST x-forwarded-for entry (the one
# your proxy appended); a peer that is NOT gets its own address and the header
# is stripped as known attacker noise. Invalid entries are ignored with a
# warning, never matched.
# TRUSTED_PROXY_CIDRS=
