{
  "name": "@buddysaradhi/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "deno run --config deno.json --allow-net --allow-env --allow-read index.ts",
    "start": "deno run --config deno.json --allow-net --allow-env --allow-read index.ts",
    "lint": "deno lint --config deno.json .",
    "typecheck": "deno check --config deno.json index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
