# apps/web/.env.example
#
# Copy to `.env.local` (git-ignored) and fill in. NEVER commit a real value —
# `.env*` is git-ignored at the repo root (`.gitignore:117`) and this file is
# the ONLY place a developer's key names are documented.
#
# Audit AUD-008 / `.planning/REQUIREMENTS.md` §86: `ALLOW_DEV_AUTH` is honoured
# in code on BOTH the gateway and the web, but it was documented NOWHERE a
# developer would look — so forgetting it looked like a broken app rather than
# a deliberate fail-safe. This file is that home.

# ── Supabase (required in every environment) ──────────────────────────────────
# The public project URL and the PUBLIC (anon) key. These are safe to expose
# to the browser: the anon key is only useful together with a user's session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The SERVICE-ROLE key. Server-only. It bypasses row-level security, so it
# must never reach a Client Component, a NEXT_PUBLIC_ variable, or a client
# bundle. It lives in `src/lib/supabase/server.ts` and in the provision route
# only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Local development only ────────────────────────────────────────────────────
# Set to "true" to enable the local-dev identity.
#
# WHAT IT OPENS: with NO Supabase session, the app may talk to the local
# database (`TURSO_DATABASE_URL`, falling back to `file:./dev.db`) as the
# synthetic tenant `local-dev`, and it may mint a `mock-token-` for the
# gateway. Both the web and the gateway require this EXACT value.
#
# WHY IT IS OFF BY DEFAULT: without it, a slow (5 s timeout) or errored auth
# read — or an unauthenticated caller hitting a server action, which is a
# public HTTP endpoint — would silently write the tutor's payment to the
# WRONG database under `tenant_id = 'local-dev'`, and the tutor would be told
# "Payment recorded" while the money was never in their books (audit AUD-008).
# Forgetting the flag must fail SAFE.
#
# NEVER set this in production.
ALLOW_DEV_AUTH=false

# The local per-tenant database. Only read when ALLOW_DEV_AUTH=true.
TURSO_DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# ── Gateway (required in every environment) ───────────────────────────────────
# The HMAC key the web signs gateway requests with, and the PIN pepper the
# web hashes PINs with. BOTH sides must resolve the SAME bytes — a divergence
# makes every PIN proof mismatch and the destructive erase endpoint returns 401
# for every tutor, permanently and silently.
#
# The gateway resolves its pepper as `PIN_PEPPER || GATEWAY_SHARED_SECRET`, so
# to keep the two sides identical set the SAME value in PIN_PEPPER on both
# sides, or leave PIN_PEPPER unset on both (then both fall back to
# GATEWAY_SHARED_SECRET). Setting it on one side only is the failure mode the
# key-separation work was written to prevent (docs/adr/0006).
GATEWAY_SHARED_SECRET=at-least-32-characters-long-or-the-app-refuses-to-boot

# The PIN pepper. Optional — but STRONGLY recommended, and REQUIRED for the
# fleet-wide key to stop doubling as an offline PIN-cracking key (audit
# AUD-041). Must be identical on the web and the gateway.
# PIN_PEPPER=at-least-32-characters-and-different-from-the-shared-secret

# Where the browser reaches the edge gateway. Used for the client-side URL
# only; the server talks to the gateway over an internal address.
NEXT_PUBLIC_GATEWAY_URL=https://api.buddysaradhi.app

# ── Product-page links (optional) ────────────────────────────────────────────
NEXT_PUBLIC_STORE_URL=https://buddysaradhi-store.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
