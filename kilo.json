{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "code",
  "instructions": ["AGENTS.md", "CLAUDE.md", ".kilo/**/*.md"],
  "permission": {
    "bash": "allow",
    "lsp": "allow",
    "edit": {
      "src/**": "allow",
      "packages/**": "allow",
      "apps/**": "allow",
      "supabase/**": "allow",
      "prisma/**": "allow",
      "*.json": "allow",
      "*.ts": "allow",
      "*.tsx": "allow",
      "*.js": "allow",
      "*.mjs": "allow",
      "*.css": "allow",
      "*.md": "allow",
      "*.toml": "allow",
      "*.yaml": "allow",
      "*.yml": "allow",
      "*.lock": "deny",
      ".env*": "deny",
      "*.db": "deny"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "semantic_search": "allow",
    "kilo_memory_save": "allow",
    "kilo_memory_recall": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true,
  "lsp": {
    "typescript": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/typescript-language-server/lib/cli.mjs",
        "--stdio"
      ],
      "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs"],
      "initializationOptions": {
        "tsserver": {
          "path": "node_modules/.pnpm/typescript@5.9.3/node_modules/typescript/lib"
        }
      }
    },
    "deno": {
      "command": ["C:/Users/haris/scoop/shims/deno.exe", "lsp"],
      "extensions": [".ts", ".tsx"],
      "env": { "DENO_DIR": ".cache/deno-lsp" }
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    }
  }
}
