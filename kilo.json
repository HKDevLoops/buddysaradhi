{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "code",
  "instructions": ["AGENTS.md", "CLAUDE.md", ".kilo/**/*.md"],
  "permission": {
    "bash": "allow",
    "lsp": "allow",
    "edit": {
      "src/**": "allow",
      "packages/**": "allow",
      "apps/**": "allow",
      "supabase/**": "allow",
      "prisma/**": "allow",
      "*.json": "allow",
      "*.ts": "allow",
      "*.tsx": "allow",
      "*.js": "allow",
      "*.mjs": "allow",
      "*.css": "allow",
      "*.md": "allow",
      "*.toml": "allow",
      "*.yaml": "allow",
      "*.yml": "allow",
      "*.lock": "deny",
      ".env*": "deny",
      "*.db": "deny"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "semantic_search": "allow",
    "kilo_memory_save": "allow",
    "kilo_memory_recall": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true,
  "lsp": {
    "typescript": {
      "disabled": false
    },
    "deno": {
      "command": ["C:/Users/haris/scoop/shims/deno.exe", "lsp"],
      "extensions": [".ts", ".tsx"],
      "env": {
        "DENO_DIR": "Z:/Projects/buddysaradhi/buddysaradhi/apps/gateway/.cache/deno-lsp"
      }
    },
    "rust": {
      "command": [
        "C:/Program Files/Rust stable MSVC 1.98/bin/rust-analyzer.exe"
      ],
      "extensions": [".rs"],
      "initialization": {
        "linkedProjects": [
          "Z:/Projects/buddysaradhi/buddysaradhi/apps/desktop/src-tauri/Cargo.toml"
        ]
      }
    },
    "yaml": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/yaml-language-server/bin/yaml-language-server",
        "--stdio"
      ],
      "extensions": [".yml", ".yaml"]
    },
    "bash": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/bash-language-server/out/cli.js",
        "start"
      ],
      "extensions": [".sh", ".bash", ".ps1"]
    },
    "css": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/vscode-langservers-extracted/lib/css-language-server/node/cssServerMain.js",
        "--stdio"
      ],
      "extensions": [".css"]
    },
    "html": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/vscode-langservers-extracted/lib/html-language-server/node/htmlServerMain.js",
        "--stdio"
      ],
      "extensions": [".html"]
    },
    "json": {
      "command": [
        "node",
        "C:/Users/haris/AppData/Roaming/npm/node_modules/vscode-langservers-extracted/lib/json-language-server/node/jsonServerMain.js",
        "--stdio"
      ],
      "extensions": [".json", ".jsonc", ".json5"]
    }
  }
}
