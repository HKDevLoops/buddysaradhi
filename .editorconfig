# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json, jsonc}]
indent_size = 2

[*.prisma]
indent_size = 2

[*.{rs, toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{yml, yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[*.scss]
indent_size = 2
