{
  "name": "buddysaradhi",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/services/*",
    "apps/gateway",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@prisma/engines",
    "@prisma/client",
    "argon2",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver",
    "puppeteer"
  ],
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate && bun --filter @buddysaradhi/shared build && bun --filter @buddysaradhi/core build",
    "build": "bun --filter @buddysaradhi/design-system build && prisma generate && bun --filter web build",
    "lint": "bun --filter web lint && bun --filter product-page lint && bun --filter @buddysaradhi/gateway lint && bun --filter @buddysaradhi/core lint && bun --filter @buddysaradhi/shared lint && bun --filter @buddysaradhi/security lint && bun --filter desktop lint && bun --filter mobile lint && bun run lint:oxlint && bun scripts/principle-lints.ts",
    "lint:fix": "bun --filter web lint --fix && bun --filter product-page lint --fix && bun --filter @buddysaradhi/gateway lint --fix && bun --filter @buddysaradhi/core lint --fix && bun --filter @buddysaradhi/shared lint --fix && bun --filter @buddysaradhi/security lint --fix && bun --filter desktop lint --fix && bun --filter mobile lint --fix && bun run lint:oxlint:fix",
    "lint:principles": "bun scripts/principle-lints.ts",
    "lint:oxlint": "oxlint --config oxlint.json",
    "lint:oxlint:fix": "oxlint --config oxlint.json --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun --filter @buddysaradhi/design-system build && bun --filter web typecheck && bun --filter @buddysaradhi/core typecheck && bun --filter @buddysaradhi/shared typecheck && bun --filter @buddysaradhi/security typecheck && bun --filter product-page typecheck && bun --filter @buddysaradhi/gateway typecheck",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:a11y": "bun --filter web test:a11y",
    "version:check": "bun scripts/version-check.ts",
    "cache:clean": "bun scripts/cache-clean.mjs",
    "cache:clean:apply": "bun scripts/cache-clean.mjs --apply",
    "cache:clean:watch": "bun scripts/cache-clean.mjs --apply --interval 30",
    "cache:clean:schedule": "powershell -ExecutionPolicy Bypass -File scripts/cache-clean-schedule.ps1 -Install",
    "cache:clean:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/cache-clean-schedule.ps1 -Uninstall",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "6.2.1",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2",
    "vercel": "^56.5.0",
    "vitest": "^4.1.10",
    "zod-prisma-types": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ],
    "*.prisma": [
      "prettier --write"
    ],
    "Cargo.toml": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-libsql": "6.2.1",
    "@prisma/client": "6.2.1",
    "@supabase/supabase-js": "^2.110.8",
    "argon2": "^0.45.1",
    "dotenv": "^16.6.1",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.24.2"
  },
  "overrides": {
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "valibot": "^1.4.2",
    "next": "16.3.8",
    "postcss": "^8.5.18",
    "sharp": "0.35.5",
    "fast-uri": "3.1.9",
    "@hono/node-server": "^2.0.5",
    "brace-expansion": "5.0.12",
    "playwright-core": "1.61.1",
    "playwright": "1.61.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "proxy-addr": "2.0.8",
    "@modelcontextprotocol/sdk": "1.32.0",
    "browserslist": "4.28.7",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.2",
    "path-to-regexp": "8.4.0",
    "source-map-js": "1.2.2",
    "handlebars": "4.7.10",
    "shell-quote": "1.11.0",
    "tar": "7.5.22",
    "nanoid": "3.3.20"
  }
}
